{
  "name": "Kirim Laporan Progress Mingguan",
  "description": "Setiap Senin pagi jam 07:00 WIB, kirim laporan progress mingguan ke semua mahasiswa via email dan notifikasi dashboard",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 * * 1",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",

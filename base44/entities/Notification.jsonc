{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "achievement",
        "feedback",
        "alert",
        "reminder",
        "system"
      ]
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "action_url": {
      "type": "string"
    },
    "sender_email": {
      "type": "string",
      "description": "Pengirim (jika dari dosen/admin)"
    }
  },
  "required": [
    "recipient_email",
    "title",
    "message"
  ]
}
{
  "name": "SystemLog",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "description": "Tindakan yang dilakukan"
    },
    "category": {
      "type": "string",
      "enum": [
        "auth",
        "module",
        "ai_interaction",
        "analytics",
        "admin",
        "error",
        "security"
      ]
    },
    "details": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ],
      "default": "info"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "pending"
      ]
    }
  },
  "required": [
    "action",
    "category"
  ]
}
{
  "name": "ForumReply",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "flagged",
        "rejected"
      ],
      "default": "approved"
    },
    "toxicity_score": {
      "type": "number",
      "default": 0
    },
    "politeness_score": {
      "type": "number",
      "default": 80
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "post_id",
    "author_email",
    "content"
  ]
}
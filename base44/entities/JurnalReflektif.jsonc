    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tag refleksi"
    },
    "ai_feedback": {
      "type": "string",
      "description": "Umpan balik AI"
    },
    "module_id": {
      "type": "string",
      "description": "ID modul terkait"
    }
  },
  "required": [
    "title",
    "content"
  ]
}